# AI 订阅比价：域名 + HTTPS 的 nginx 配置模板。
#
# 使用前必读（服务器上已有 OpenSubs 占用 443 和 IP 证书）：
#   1. 这份模板只新增「server_name 为你的域名」的 server 块，不写 default_server，不改任何已有配置。
#      nginx 会按 SNI/Host 把域名流量分给本站，OpenSubs 的域名和 https://IP 仍然走它原来的块。
#   2. 先执行 `sudo nginx -T | grep -nE "listen|server_name|ssl_certificate"`，确认：
#        - 已有的 443 块是否带 default_server；本模板不会抢它。
#        - 你的域名不与已有 server_name 重复。
#      不确定就先停下来问，不要 reload。
#   3. 不想碰 443 的话，把下面 `listen 443` 改成别的端口（例如 8443），用 https://域名:8443 访问。
#   4. 证书用 certbot 的 webroot 方式签发（certonly），不要用 `certbot --nginx`，
#      后者会改写其他站点的配置。步骤见 README「HTTPS」。
#   5. 先 `sudo nginx -t`，通过再 `sudo systemctl reload nginx`（不要 restart）。
#
# 用法：把 YOUR_DOMAIN 替换为实际域名后放到 /etc/nginx/conf.d/aishops-domain.conf

limit_req_zone $binary_remote_addr zone=aishops_api:10m rate=3r/s;
limit_req_zone $binary_remote_addr zone=aishops_go:10m  rate=1r/s;

# 80：只负责签发证书与跳转到 https。仅匹配本站域名，不影响其他站点。
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;          # 注意：没有 default_server
    listen [::]:443 ssl;
    http2 on;
    server_name YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:AISHOPS_SSL:10m;
    ssl_session_tickets off;

    # HSTS：先用短时间（5 分钟）确认 HTTPS 完全正常，再改成 31536000（一年）。
    # 不加 includeSubDomains / preload，避免波及同域名下的其他站点（例如 sub.xxx 的 OpenSubs）。
    add_header Strict-Transport-Security "max-age=300" always;
    # CSP、X-Content-Type-Options、Referrer-Policy、Permissions-Policy、X-Frame-Options 由应用返回，这里不重复添加。

    server_tokens off;
    client_max_body_size 1m;

    # 接口：按 IP 限流（应用内还有一层限流）；超出返回 429
    location /api/ {
        limit_req zone=aishops_api burst=30 nodelay;
        limit_req_status 429;
        include /etc/nginx/aishops-proxy.conf;
    }
    location /go/ {
        limit_req zone=aishops_go burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/aishops-proxy.conf;
    }
    location / {
        include /etc/nginx/aishops-proxy.conf;
    }
}
