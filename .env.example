# 复制为 .env 后修改：cp .env.example .env
POSTGRES_DB=aishops
POSTGRES_USER=aishops
# 必填：请换成强密码（建议 openssl rand -hex 24，只用字母数字，避免 URL 特殊字符）
POSTGRES_PASSWORD=change-me

# app 对外监听。默认只监听本机 127.0.0.1，由 Nginx/Caddy 反代并加 HTTPS。
# 想直接用 IP:端口 访问（不推荐，没有 HTTPS）可改成 0.0.0.0
APP_BIND=127.0.0.1
APP_PORT=8000

# 不用 docker compose、直接跑 Python 时使用（compose 会自动拼好，无需设置）：
# DATABASE_URL=postgresql://aishops:change-me@127.0.0.1:5432/aishops
# 不设置 DATABASE_URL 时回退到本地 SQLite（仅限开发）：data/dev.sqlite3
