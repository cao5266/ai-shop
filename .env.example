# 复制为 .env 后修改：cp .env.example .env && chmod 600 .env
POSTGRES_DB=aishops
POSTGRES_USER=aishops
# 必填：强密码（openssl rand -hex 24，只用字母数字，避免 URL 特殊字符）
POSTGRES_PASSWORD=change-me

# 必填：字段加密密钥（Fernet）。生成：docker compose run app python -m backend.cli gen-key
# 丢了这个密钥，数据库里的加密字段（店铺链接等）就无法恢复，请单独备份到密码管理器。
# 轮换：逗号分隔，新密钥放最前面，例如 FIELD_ENCRYPTION_KEY=新密钥,旧密钥（见 README）
FIELD_ENCRYPTION_KEY=
# 必填：接口会话签名与跳转令牌的密钥。生成：openssl rand -hex 32。
# 换掉后所有在线会话和已打开页面里的跳转链接立即失效，刷新页面即可恢复。
API_SIGNING_SECRET=

# app 对外监听。默认只监听本机 127.0.0.1，由 nginx 反代并加 HTTPS。
APP_BIND=127.0.0.1
APP_PORT=8000

# Docker 构建前端时用的 npm 镜像（服务器在大陆，默认腾讯云）
NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/

# 可选：Postgres 数据目录放到加密卷（LUKS 挂载点），留空则用 Docker 命名卷
# PGDATA_PATH=/srv/aishops-secure/pgdata

# 加密备份（scripts/backup_encrypted.sh）：二选一
# BACKUP_AGE_RECIPIENT=age1xxxxxxxx      # 用 age：填公钥
# BACKUP_GPG_RECIPIENT=backup@example    # 用 gpg：填收件人公钥 ID（私钥不要放在服务器上）

# 可选限流（每个 IP 每分钟）
# RL_API=120
# RL_SESSION=20
# RL_GO=40
